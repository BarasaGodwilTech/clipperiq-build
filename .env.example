# ClipperIQ Studio — configuration
# ─────────────────────────────────────────────────────────────────────────────
# This is the ONE config file for the whole app (server + frontend). Copy it to
# ".env" in this same folder (the repo root, next to start.bat) and fill in
# what you need — everything has a working default, so you don't need to touch
# this at all just to try the app locally.
#
# The server reads this file directly. The browser picks up the platform app
# IDs below automatically on load (via GET /api/config/public) — so this one
# file is all you need instead of re-entering keys in Settings → API Keys or
# the admin panel. (Those still work too, as a per-browser override — a value
# set here just takes priority whenever it's non-empty.)

# ─── Network ──────────────────────────────────────────────────────────────────
# Port the server listens on.
PORT=3000
# Host/interface to bind. 127.0.0.1 = only this machine. Use 0.0.0.0 on a VPS
# so it accepts connections from outside (put it behind a reverse proxy + HTTPS).
HOST=127.0.0.1
# If you're running behind a reverse proxy / tunnel with a fixed public address
# (e.g. https://clips.example.com), set it here. This makes rendered-clip and
# Instagram-publish URLs always correct, and is required for Instagram
# publishing to work (Instagram must be able to fetch the clip over https).
PUBLIC_BASE_URL=
# Comma-separated list of origins allowed to call this API (CORS). Leave blank
# to allow any origin — fine for local use or when the frontend is served by
# this same server (the default).
ALLOWED_ORIGINS=

# ─── Security ─────────────────────────────────────────────────────────────────
# Set these to require an HTTP Basic Auth login for the whole app. Leave blank
# for local/dev use. STRONGLY recommended once you deploy to a public VPS —
# without it, anyone who finds the URL can upload video and spend your
# TikTok/YouTube/Instagram API quota.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Where uploads, rendered clips, background-music tracks, logs and the database
# file are kept. A relative path is resolved from the server/ folder (so the
# default below means server/data). Point this at a large disk if you're
# processing long/high-resolution videos.
DATA_DIR=data
# Largest source video the server will accept, in gigabytes.
MAX_UPLOAD_GB=8
# How many days to keep an original uploaded video after it's been processed.
# 0 = keep forever.
SOURCE_RETENTION_DAYS=30
# How many days rendered clips stay on the server after they were made. The app
# downloads its own copy, but if your browser ever loses it, it fetches it again
# from here, so keep this generous. 0 = keep forever.
CLIP_RETENTION_DAYS=30

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
# Leave both blank to use the ffmpeg/ffprobe that "npm install" downloads
# automatically. Only set these if you want to use a system install instead.
FFMPEG_PATH=
FFPROBE_PATH=
# Encoding speed vs. file size: ultrafast, superfast, veryfast (default),
# faster, fast, medium, slow, slower, veryslow.
FFMPEG_PRESET=veryfast
# Quality (x264 CRF). Lower = better quality & bigger files. 18-23 is typical.
FFMPEG_CRF=20
# How many clips to render at the same time. Raise this on a multi-core VPS to
# process a batch faster; each render is itself single/multi-threaded ffmpeg.
MAX_CONCURRENT_RENDERS=1
# Kill a single clip render that's stuck for longer than this (minutes).
RENDER_TIMEOUT_MIN=90

# ─── Background music ──────────────────────────────────────────────────────────
# yt-dlp powers background music fetched from a link (YouTube/TikTok/SoundCloud)
# and /api/audio preview. It's downloaded automatically the first time it's used.
YTDLP_AUTO_DOWNLOAD=true
# Point at an existing yt-dlp install instead of auto-downloading one.
YTDLP_PATH=

# ─── Platform app credentials ─────────────────────────────────────────────────
# Set these once here and every browser that opens the app picks up the app ID
# automatically — no more per-device Settings entry. Client *secrets* stay on
# the server and are never sent to the browser.
#
# TikTok — register at https://developers.tiktok.com/
#   App type: Web · Scopes: user.info.basic, video.upload, video.publish
#   Redirect URI to add: <your-domain>/auth/callback.html
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
#
# Google / YouTube — register at https://console.cloud.google.com/
#   Enable: YouTube Data API v3 · Scopes: youtube.upload, youtube.readonly
#   Redirect URI to add: <your-domain>/auth/callback.html
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Facebook / Instagram — register at https://developers.facebook.com/
#   Products: Facebook Login, Instagram Graph API
#   Permissions: instagram_basic, instagram_content_publish, pages_read_engagement
#   Redirect URI to add: <your-domain>/auth/callback.html
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Logging ──────────────────────────────────────────────────────────────────
# debug, info (default), warn, or error.
LOG_LEVEL=info

# ── Speed tuning (all optional; sensible automatic defaults) ──────────────────
# How many clips of one job render at the same time. Auto: 1 on <4 CPU cores, 2 on 4-11, 3 on 12+.
# Raise it if your CPU is mostly idle while rendering; lower it if the computer becomes sluggish.
# CLIP_CONCURRENCY=2
# Normalise background music once per job instead of once per clip (faster, same loudness). 0 = off.
# BGM_PRENORMALIZE=1
# x264 speed/size trade-off: ultrafast, superfast, veryfast (default), faster, fast, medium
# FFMPEG_PRESET=veryfast

# Video encoder. libx264 (software) works everywhere. Set to "auto" to use a graphics-card encoder
# (NVIDIA NVENC, Intel Quick Sync, AMD AMF, Apple VideoToolbox) when this machine has a working one;
# if it doesn't, or a render fails, ClipperIQ quietly uses software instead. The server log says which was chosen.
# VIDEO_ENCODER=libx264

# ── Auto captions (speech to text) ────────────────────────────────────────────────────────
# Captions need ONE of these set up. Importing an .srt / .vtt file and typing captions work without any of them.
# auto = use the first one that is ready (faster-whisper, then whisper-cpp, then openai-api).  off = switch speech to text off.
CAPTION_ENGINE=auto
# 1) faster-whisper (easiest, free, runs on this computer):  install Python, then run:  pip install faster-whisper
#    WHISPER_MODEL: tiny | base | small | medium | large-v3  (bigger = more accurate and slower; "small" is a good start)
WHISPER_MODEL=small
# WHISPER_PYTHON=python
# 2) whisper.cpp (no Python): download the program and a ggml model file, then point to them
# WHISPER_CPP_BIN=C:\tools\whisper\whisper-cli.exe
# WHISPER_CPP_MODEL=C:\tools\whisper\ggml-small.bin
# 3) OpenAI's hosted Whisper (needs an account; the audio is sent to OpenAI and billed by them)
# OPENAI_API_KEY=sk-...

