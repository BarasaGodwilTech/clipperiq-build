{
  "name": "clipperiq-studio-desktop",
  "productName": "ClipperIQ Studio",
  "version": "2.1.0",
  "description": "ClipperIQ Studio desktop app: the video server and the app in one installable program",
  "author": "ClipperIQ",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clipperiq.studio",
    "productName": "ClipperIQ Studio",
    "asar": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      {
        "from": "..",
        "to": "app-root",
        "filter": [
          "index.html", "manifest.json", "service-worker.js", "favicon.ico", "logo1024x1024.jpg",
          "privacy.html", "terms.html", "data-deletion.html", "CNAME",
          "css/**", "js/**", "admin/**", "auth/**", "config/**",
          "server/index.js", "server/package.json", "server/package-lock.json",
          "server/src/**", "server/assets/**", "server/scripts/**", "server/node_modules/**",
          "!server/node_modules/.cache/**", "!server/data/**", "!**/*.log"
        ]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipperIQ Studio"
    }
  }
}
