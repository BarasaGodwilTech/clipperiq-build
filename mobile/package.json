{
  "name": "clipperiq-studio-mobile",
  "version": "2.1.0",
  "private": true,
  "description": "Android app for ClipperIQ Studio: cuts clips on the phone with a native video engine (no server needed); can also connect to a server",
  "scripts": {
    "icons": "capacitor-assets generate --android",
    "add": "cap add android",
    "sync": "cap sync android",
    "apk:debug": "cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "clipperiq-engine": "file:plugins/clipperiq-engine"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
